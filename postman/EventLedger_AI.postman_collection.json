    {
      "name": "04. Webhooks (Idempotency & Deduplication)",
      "item": [
        {
          "name": "Deliver Cashfree Webhook",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('unique_webhook_id', 'wh_evt_' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Webhook processed successfully', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('SUCCESS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-webhook-timestamp", "value": "1731412800" },
              { "key": "x-webhook-signature", "value": "" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{unique_webhook_id}}\",\n  \"type\": \"PAYMENT_SUCCESS_WEBHOOK\",\n  \"data\": {\n    \"order\": {\n      \"order_id\": \"{{payment_order_id}}\"\n    },\n    \"payment\": {\n      \"cf_payment_id\": \"98721491\",\n      \"payment_status\": \"SUCCESS\",\n      \"payment_amount\": 45.00,\n      \"payment_currency\": \"USD\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/webhooks/cashfree",
              "host": ["{{base_url}}"],
              "path": ["api", "webhooks", "cashfree"]
            }
          }
        },
