  "item": [
    {
      "name": "01. Dashboard & Events",
      "item": [
        {
          "name": "Get Dashboard Overview",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains metrics', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('metrics');",
                  "    pm.expect(json.metrics).to.have.property('total_events');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Organization-Id", "value": "{{org_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/dashboard/overview",
              "host": ["{{base_url}}"],
              "path": ["api", "dashboard", "overview"]
            }
          }
        },
        {
          "name": "List All Events",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns event list', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    if (json.length > 0) {",
                  "        pm.environment.set('event_id', json[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Organization-Id", "value": "{{org_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/events",
              "host": ["{{base_url}}"],
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Event created with decimal amount', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
