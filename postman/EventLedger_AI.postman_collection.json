    {
      "name": "03. Common Payment Orders & Sandbox Checkout",
      "item": [
        {
          "name": "Create Multi-Provider Payment Order (Cashfree)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
