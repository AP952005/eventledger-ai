          "name": "Deliver Duplicate Cashfree Webhook (Deduplication Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Duplicate webhook is ignored', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('IGNORED_DUPLICATE');",
                  "});"
                ],
